# Target URL for backend API hosted on Render (no trailing slash).
# In production on Vercel, set this in Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://neeraja-sundeep-backend.onrender.com
#
# In local development, leave this empty to use the Vite proxy (/api -> http://localhost:5000):
VITE_API_URL=
