# Server Port (Render sets this automatically to 10000)
PORT=5000

# MongoDB Connection String (Atlas)
# e.g.: mongodb+srv://sudeeppazhoor_db_user:<password>@cluster0.y8o3lfd.mongodb.net/wedding?retryWrites=true&w=majority
MONGODB_URI=

# Allowed Frontend Origins for CORS (comma-separated, or leave blank to allow all during setup)
# e.g.: https://your-project.vercel.app,http://localhost:5173
CLIENT_ORIGIN=
