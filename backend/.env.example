# Server Port
PORT=5000

# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wedding?retryWrites=true&w=majority

# Optional: comma-separated list of allowed browser origins for CORS.
# Defaults to permissive if unset, or restrict to your frontend URL:
CLIENT_ORIGIN=http://localhost:5173

